/*
========================================================================================
    Nextflow Configuration File
========================================================================================
    Configuration for SPAdes-Bakta-Panta-PASA pipeline
========================================================================================
*/

// Pipeline parameters
params {
    // =========================================================================
    // INPUT/OUTPUT
    // =========================================================================
    input  = null
    outdir = './validation_results_no_preprocess'

    // =========================================================================
    // RESOURCE LIMITS
    // =========================================================================
    max_cpus   = 8
    max_memory = 30.GB

    // =========================================================================
    // WORKFLOW TOGGLES
    // =========================================================================
    run_preprocessing  = false    // Preprocessing: fastp + Kraken2 + KrakenTools
    sourmash_classify  = true    // Classification: Sourmash + genus downloads + ANI
    phylo_enable       = false    // Phylogenetics: core gene alignment + IQ-TREE
    pangenomics_enable = false    // Pangenomics: Panta + EggNOG + antiSMASH
    eggnog_enable      = true    // EggNOG functional annotation
    qc_after_pasa      = false   // Run QC after PASA scaffolding

    // =========================================================================
    // DATABASES
    // =========================================================================
    database_base   = '/BGC-data/databases'
    genome_database = "${params.database_base}/genomes"
    kraken2_db      = "${params.database_base}/kraken2"
    eggnog_db       = "${params.database_base}/eggnog"
    antismash_db    = "${params.database_base}/antismash"

    // =========================================================================
    // QUALITY FILTERING
    // =========================================================================
    filter_min_completeness  = 90   // Minimum completeness % (CheckM2)
    filter_max_contamination = 5    // Maximum contamination % (CheckM2)
    filter_family            = true
    filter_target_family     = 'Lactobacillaceae'

    // =========================================================================
    // CLASSIFICATION (Sourmash/Skani)
    // =========================================================================
    database_source = 'gtdb'      // 'gtdb' or 'ncbi'
    skani_preset    = '--medium'  // '--medium', '--slow', or '--small-genomes'

    // =========================================================================
    // PANTA (per-sample pangenome)
    // =========================================================================
    panta_identity       = 0.7       // Sequence identity threshold
    panta_length_diff    = 0.7       // Length difference cutoff
    panta_align_long     = 0         // Alignment coverage for longer seq
    panta_align_short    = 0         // Alignment coverage for shorter seq
    panta_evalue         = '1e-06'
    panta_blast_method   = 'diamond' // 'diamond' or 'blast'
    panta_split_paralogs = true
    panta_core           = 0.99      // Core genes threshold
    panta_soft           = 0.95      // Soft core threshold
    panta_shell          = 0.15      // Shell genes threshold

    // =========================================================================
    // PASA (scaffolding)
    // =========================================================================
    pasa_mode   = 'both'  // 'standard', 'sensitive', or 'both'
    pasa_filter = true    // Filter scaffolds by QC metrics

    // =========================================================================
    // PHYLOGENETICS
    // =========================================================================
    // Pangenome clustering (for core gene extraction)
    pangenome_identity       = 0.95
    pangenome_LD             = 0.9
    pangenome_evalue         = '1e-6'
    pangenome_blast_method   = 'diamond'
    pangenome_split_paralogs = true

    // MAFFT alignment
    phylo_core_threshold = 0.95   // Fraction of genomes gene must be in
    mafft_method         = 'auto' // 'auto', 'linsi', 'einsi', 'ginsi', 'fftns2'

    // IQ-TREE
    phylo_model               = 'GTR+G'
    phylo_modelfinder         = false
    phylo_use_partition       = false
    phylo_bootstrap           = true
    phylo_bootstrap_replicates = 1000
    phylo_alrt                = 0

    // Tree Visualization (generates both circular and rectangular layouts)
    tree_width                = 1000          // Canvas width in pixels
    tree_height               = 1000          // Canvas height in pixels
    tree_show_bootstrap       = true          // Show bootstrap support values

    // =========================================================================
    // PANGENOMICS (EggNOG + antiSMASH)
    // =========================================================================
    eggnog_mode        = 'diamond'
    eggnog_taxon       = 'Lactobacillaceae'
    antismash_extra_args = ''
}

// Process configuration
process {
    // Global process settings
    // Exit codes: 1 (general/OOM), 104 (SIGKILL), 137 (128+9 SIGKILL), 140 (128+12), 143 (128+15 SIGTERM)
    errorStrategy = { task.exitStatus in [1, 104, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 3

    // Default resource settings (add 4GB per retry attempt, capped at max_memory)
    cpus = 2
    memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
    time = 1.h

    // =====================================
    // PREPROCESSING WORKFLOW (Optional)
    // =====================================

    withName: 'FASTQC' {
        cpus = 2
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.m
    }

    withName: 'FASTP' {
        cpus = 4
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 5.m
    }

    withName: 'KRAKEN2' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 10.m
    }

    withName: 'KRAKENTOOLS' {
        cpus = 1
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
    }

    // =====================================
    // CORE ASSEMBLY AND ANNOTATION
    // =====================================

    withName: 'SPADES' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
        errorStrategy = { task.exitStatus == 21 ? 'ignore' : (task.exitStatus in [1, 104, 137, 140, 143] ? 'retry' : 'finish') }
    }

    withName: 'BAKTA' {
        cpus = 4
        memory = { [15.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
    }

    // =====================================
    // CLASSIFICATION WORKFLOW
    // =====================================

    withName: 'SOURMASH' {
        cpus = 1
        memory = { [6.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'GENUS_DOWNLOAD' {
        cpus = 1
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'MERGE_GFF_FASTA' {
        cpus = 2
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'CHECKM2_GENUS' {
        cpus = 2
        memory = { [20.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1440.m
    }

    withName: 'BAKTA_GENUS' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1440.m
    }

    withName: 'SKANI_BUILD_DB' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'SKANI_SEARCH' {
        cpus = 2
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 10.m
    }

    withName: 'REFERENCE_SELECTOR' {
        cpus = 1
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.m
    }

    // =====================================
    // QC AND FILTERING
    // =====================================

    withName: 'BUSCO' {
        cpus = 2
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
        errorStrategy = 'ignore'  // Skip samples with poor quality assemblies
    }

    withName: 'CHECKM2' {
        cpus = 2
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
        errorStrategy = 'ignore'  // Skip samples with poor quality assemblies
    }

    withName: 'QUAST' {
        cpus = 2
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
        errorStrategy = 'ignore'  // Skip samples with insufficient/poor quality contigs
    }

    withName: 'MULTIQC_AGGREGATE' {
        cpus = 1
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.m
    }

    withName: 'HQ_FILTER' {
        cpus = 1
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.m
    }

    // =====================================
    // PANGENOME AND SCAFFOLDING
    // =====================================

    withName: 'PANTA' {
        cpus = 4
        memory = { [4.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
        errorStrategy = 'ignore'
    }

    withName: 'PASA' {
        cpus = 1
        memory = { [4.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
    }

    withName: 'PASA_FILTER' {
        cpus = 1
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.m
    }

    // =====================================
    // PHYLOGENETIC ANALYSIS (Optional)
    // =====================================

    withName: 'EXTRACT_CORE_GENES' {
        cpus = 1
        memory = { [1.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 10.m
    }

    withName: 'ALIGN_CORE_GENES' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'CONCATENATE_ALIGNMENT' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'IQTREE3' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'TREE_VISUALIZATION' {
        cpus = 1
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 10.m
        conda = "conda-forge::toytree conda-forge::packaging"
        container = null
    }

    // =====================================
    // PANGENOMICS ANALYSIS (Optional)
    // =====================================

    withName: 'BAKTA_PANGENOMICS' {
        cpus = 4
        memory = { [15.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'PANTA_COHORT' {
        cpus = 4
        memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 15.m
    }

    withName: 'EGGNOG' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 12.h
    }

    withName: 'ANTISMASH' {
        cpus = 2
        memory = { [12.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
    }

    withName: 'PANGENOME_PLOTS' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }
}

// Docker configuration
docker {
    enabled = true
    runOptions = "--user ${System.getenv('USER_ID') ?: '1000'}:${System.getenv('GROUP_ID') ?: '1000'} -v /home/azureuser/BGC-link/nextflow/databases:/databases -v /BGC-data/databases:/BGC-data/databases"
    temp = 'auto'
}

// Conda configuration (for processes without containers)
conda {
    enabled = true
}

// Singularity configuration (alternative to Docker)
singularity {
    enabled = false
    autoMounts = true
}

// Execution profiles
profiles {
    singularity {
        singularity {
            enabled = true
        }
        docker {
            enabled = false
        }
    }

    test {
        params {
            input = "${projectDir}/input/samplesheet.csv"
            outdir = "${projectDir}/test_results"
        }
    }

    standard {
        process {
            executor = 'local'
        }
    }

    slurm {
        process {
            executor = 'slurm'
            queue = 'normal'
            clusterOptions = '--account=your_account'
        }
    }
}

// Reporting and tracing
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

workDir = "${launchDir}/work"

manifest {
    name = 'spades-bakta-panta-pasa'
    author = 'BGC-link Project'
    description = 'Bacterial genome assembly, annotation, pangenome analysis, and scaffolding pipeline'
    mainScript = 'main.nf'
    version = '2.0.0'
    nextflowVersion = '>=21.04.0'
}
