/*
========================================================================================
    Nextflow Configuration File
========================================================================================
    Configuration for SPAdes-Bakta-Panta-PASA pipeline
========================================================================================
*/

// Pipeline parameters
params {
    // Input/Output
    input = null
    outdir = './results'
    
    // Genome database location (for classification workflow)
    genome_database = "/BGC-data/databases/genomes"
    
    // Panta parameters  
    panta_identity = 0.7    // Minimum sequence identity (0.7 = 70%)
    panta_length_diff = 0.7 // Length difference cutoff (0.7 = 70%)
    panta_align_long = 0    // Alignment coverage for longer sequence (0 = no requirement)
    panta_align_short = 0   // Alignment coverage for shorter sequence (0 = no requirement)
    panta_evalue = '1e-06'  // Blast E-value threshold
    panta_blast_method = 'diamond'  // Alignment method: 'diamond' or 'blast'
    panta_split_paralogs = true     // Split paralog clusters (true/false)
    panta_core = 0.99       // Core genes threshold (0.99 = 99%)
    panta_soft = 0.95       // Soft core threshold (0.95 = 95%)  
    panta_shell = 0.15      // Shell genes threshold (0.15 = 15%)
    
    // PASA parameters
    pasa_mode = 'both'      // Options: 'standard', 'sensitive', 'both'
    pasa_filter = true      // Enable PASA scaffold selection based on QC metrics
    
    // Classification parameters
    sourmash_classify = true // Run sourmash taxonomic classification with genus downloads and ANI species assignment
    database_source = 'gtdb'  // Options: 'gtdb' (default), 'ncbi' for genome downloads
    skani_preset = '--medium' // Skani preset: '--medium' (default, ANI ≤95%, N50 ≤10kb), '--slow' (N50 ~3kb), '--small-genomes'
    
    // HQ filtering parameters (CheckM2-based quality filtering before classification)
    filter_family = true            // Filter by taxonomic family (in CLASSIFICATION workflow)
    filter_target_family = 'Lactobacillaceae'  // Target family for filtering
    filter_max_contamination = 5    // Maximum contamination percentage allowed (HQ filter)
    filter_min_completeness = 90    // Minimum completeness percentage required (HQ filter)
    
    // QC parameters

    // Preprocessing control (off by default)
    run_preprocessing = true  // Run fastp + Kraken2 + KrakenTools preprocessing before assembly

    // QC execution control
    // Note: QC_SPADES (CheckM2) always runs for HQ filtering
    qc_after_pasa = false      // Run comprehensive QC after PASA scaffolding
    
    // Phylogenetic analysis parameters (PHYLOGENETICS subworkflow)
    phylo_enable = true            // Enable phylogenetic tree construction
    
    // PANGENOME (PANTA) Parameters for phylogenetics
    pangenome_identity = 0.95          // Sequence identity threshold for clustering (0.0-1.0)
    pangenome_LD = 0.9                 // Length difference cutoff (0.0-1.0)
    pangenome_evalue = '1e-6'          // BLAST E-value threshold
    pangenome_blast_method = 'diamond' // Alignment method: 'diamond' (fast) or 'blast' (sensitive)
    pangenome_split_paralogs = true    // Split paralog clusters (recommended: true)
    
    // MAFFT Alignment Parameters
    phylo_core_threshold = 0.95    // Core gene threshold - fraction of genomes a gene must be present in
    mafft_method = 'auto'          // MAFFT alignment method: 'auto', 'linsi', 'einsi', 'ginsi', 'fftns2'
    
    // IQ-TREE 3 Parameters
    phylo_model = 'GTR+G'          // Substitution model: 'GTR+G', 'GTR+I+G', 'GTR+F+G', 'HKY+G', 'TIM+G'
    phylo_modelfinder = false      // Use ModelFinder to automatically select best-fit model
    phylo_use_partition = false    // Use partition model (separate model per gene)
    phylo_bootstrap = true         // Bootstrap analysis
    phylo_bootstrap_replicates = 1000  // Number of ultrafast bootstrap (UFBoot2) replicates
    phylo_alrt = 0                 // SH-aLRT test replicates (0 = disabled)

    // Pangenomics analysis parameters (PANGENOMICS subworkflow)
    pangenomics_enable = true      // Enable pangenomics analysis (Panta → EggNOG + antiSMASH → Plotting)

    // EggNOG-mapper parameters
    eggnog_enable = true             // Enable EggNOG functional annotation (requires database)
    eggnog_db = '/BGC-data/databases/eggnog'  // Path to EggNOG database
    eggnog_mode = 'hmmer'            // Search mode: 'hmmer' with Lactobacillaceae-specific database
    eggnog_taxon = 'Lactobacillaceae' // Taxon-specific HMMER database (33958)

    // antiSMASH parameters
    antismash_db = '/BGC-data/databases/antismash'  // Path to antiSMASH database
    antismash_extra_args = ''        // Additional antiSMASH arguments

    // System maximum resources
    max_cpus = 8
    max_memory = '30.GB'
    max_time = '4.h'
}

// Process configuration
process {
    // Global process settings
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2
    
    // Default resource settings for lightweight processes
    cpus = 2
    memory = 2.GB
    time = 1.h
    
    // Container engine
    container = null
    
    // Resource labels based on actual usage patterns
    withLabel: 'process_low' {
        cpus = 2
        memory = 2.GB
        time = 1.h
    }
    
    withLabel: 'process_medium' {
        cpus = 4
        memory = 8.GB
        time = 2.h
    }
    
    withLabel: 'process_high' {
        cpus = 8
        memory = 16.GB
        time = 4.h
    }
    
    // =====================================
    // PREPROCESSING WORKFLOW (Optional)
    // =====================================
    
    withName: 'PREPROCESSING:FASTQC' {
        cpus = 4
        memory = 8.GB
        time = 30.m
        label = 'process_medium'
    }
    
    withName: 'PREPROCESSING:FASTP' {
        cpus = 4
        memory = 8.GB
        time = 30.m
        label = 'process_medium'
    }
    
    withName: 'PREPROCESSING:KRAKEN2' {
        cpus = 4
        memory = 8.GB
        time = 30.m
        label = 'process_medium'
    }
    
    withName: 'PREPROCESSING:KRAKENTOOLS' {
        cpus = 2
        memory = 4.GB
        time = 30.m
        label = 'process_low'
    }
    
    // =====================================
    // CORE ASSEMBLY AND ANNOTATION
    // =====================================
    
    withName: 'SPADES' {
        cpus = 4
        memory = 4.GB
        time = 20.m
        label = 'process_high'
    }
    
    withName: 'BAKTA' {
        cpus = 4
        memory = 12.GB
        time = 30.m
        label = 'process_medium'
    }
    
    // =====================================
    // CLASSIFICATION WORKFLOW
    // =====================================
    
    withName: 'CLASSIFICATION:SOURMASH' {
        cpus = 1
        memory = 6.GB
        time = 15.m
        label = 'process_medium'
    }
    
    // Genus download - uses storeDir for caching
    withName: 'CLASSIFICATION:GENUS_DOWNLOAD' {
        cpus = 1
        memory = 2.GB
        time = 30.m
        label = 'process_medium'
    }

    // Merge GFF + FASTA into GFF3 files
    withName: 'CLASSIFICATION:MERGE_GFF_FASTA' {
        cpus = 2
        memory = 2.GB
        time = 30.m
        label = 'process_low'
    }

    // CheckM2 for genus genomes
    withName: 'CLASSIFICATION:CHECKM2_GENUS' {
        cpus = 2
        memory = 20.GB
        time = 240.m
        label = 'process_high'
    }
    
    // Bakta annotation for genomes missing GFF3
    withName: 'CLASSIFICATION:BAKTA_GENUS' {
        cpus = 4
        memory = 16.GB
        time = 240.m
        label = 'process_high'
    }
    
    // Skani database building - empty in CSV means max resources
    withName: 'CLASSIFICATION:SKANI_BUILD_DB' {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
        label = 'process_medium'
    }
    
    // Skani search per sample
    withName: 'CLASSIFICATION:SKANI_SEARCH' {
        cpus = 2
        memory = 2.GB
        time = 10.m
        label = 'process_medium'
    }
    
    // Reference selection
    withName: 'CLASSIFICATION:REFERENCE_SELECTOR' {
        cpus = 1
        memory = 1.GB
        time = 2.m
        label = 'process_low'
    }
    
    // =====================================
    // QC AND FILTERING
    // =====================================
    
    withName: 'BUSCO' {
        cpus = 2
        memory = 1.GB
        time = 2.m
        label = 'process_medium'
    }
    
    withName: 'CHECKM2' {
        cpus = 2
        memory = 16.GB
        time = 4.m
        label = 'process_medium'
    }
    
    withName: 'QUAST' {
        cpus = 2
        memory = 1.GB
        time = 2.m
        label = 'process_low'
    }
    
    withName: 'HQ_FILTER' {
        cpus = 1
        memory = 1.GB
        time = 2.m
        label = 'process_low'
    }
    
    // =====================================
    // PANGENOME AND SCAFFOLDING
    // =====================================
    
    withName: 'PANTA' {
        cpus = 4
        memory = 2.GB
        time = 4.m
        label = 'process_medium'
    }
    
    withName: 'PASA' {
        cpus = 1
        memory = 2.GB
        time = 30.m
        label = 'process_low'
    }
    
    withName: 'PASA_FILTER' {
        cpus = 1
        memory = 1.GB
        time = 2.m
        label = 'process_low'
    }

    // =====================================
    // REPORTING AND AGGREGATION
    // =====================================
    
    withName: 'MULTIQC_AGGREGATE' {
        cpus = 1
        memory = 1.GB
        time = 2.m
        label = 'process_low'
    }
    
    // =====================================
    // PHYLOGENETIC ANALYSIS (Optional)
    // =====================================

    withName: 'PHYLOGENETICS:EXTRACT_CORE_GENES' {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
        label = 'process_low'
    }
    
    withName: 'PHYLOGENETICS:ALIGN_CORE_GENES' {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
        label = 'process_high'
    }
    
    withName: 'PHYLOGENETICS:CONCATENATE_ALIGNMENT' {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
        label = 'process_low'
    }
    
    withName: 'PHYLOGENETICS:IQTREE3' {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
        label = 'process_high'
    }

    // =====================================
    // PANGENOMICS ANALYSIS (Optional)
    // =====================================

    withName: 'PANGENOMICS:BAKTA_PANGENOMICS' {
        cpus = 4
        memory = 12.GB
        time = 30.m
        label = 'process_medium'
    }

    withName: 'PANGENOMICS:PANTA_COHORT' {
        cpus = params.max_cpus
        memory = params.max_memory
        time = params.max_time
        label = 'process_high'
    }

    withName: 'PANGENOMICS:EGGNOG' {
        cpus = 4
        memory = 8.GB
        time = 2.h
        label = 'process_high'
    }

    withName: 'PANGENOMICS:ANTISMASH' {
        cpus = 4
        memory = 8.GB
        time = 2.h
        label = 'process_high'
    }

    withName: 'PANGENOMICS:PANGENOME_PLOTS' {
        cpus = 2
        memory = 4.GB
        time = 30.m
        label = 'process_medium'
    }
}

// Docker configuration
docker {
    enabled = true
    runOptions = "--user ${System.getenv('USER_ID') ?: '1000'}:${System.getenv('GROUP_ID') ?: '1000'} -v /home/azureuser/BGC-link/nextflow/databases:/databases -v /BGC-data/databases:/BGC-data/databases"
    temp = 'auto'
}

// Singularity configuration (alternative to Docker)
singularity {
    enabled = false
    autoMounts = true
}

// Execution profiles
profiles {
    docker {
        docker {
            enabled = true
        }
        singularity {
            enabled = false
        }
    }
    
    singularity {
        singularity {
            enabled = true
        }
        docker {
            enabled = false
        }
    }
    
    test {
        params {
            input = "${projectDir}/input/samplesheet.csv"
            outdir = "${projectDir}/test_results"
        }
    }
    
    standard {
        process {
            executor = 'local'
        }
    }
    
    slurm {
        process {
            executor = 'slurm'
            queue = 'normal'
            clusterOptions = '--account=your_account'
        }
    }
}

// Reporting and tracing
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

workDir = "${launchDir}/work"

manifest {
    name = 'spades-bakta-panta-pasa'
    author = 'BGC-link Project'
    description = 'Bacterial genome assembly, annotation, pangenome analysis, and scaffolding pipeline'
    mainScript = 'main.nf'
    version = '2.0.0'
    nextflowVersion = '>=21.04.0'
}
