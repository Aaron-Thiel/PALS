/*
========================================================================================
    BGC-link Pipeline Orchestrator Configuration
========================================================================================
    Main configuration file for the BGC-link pipeline orchestrator.

    This config provides defaults for the orchestrator. Each sub-pipeline has its
    own configuration file:
      - assembly.config:  Assembly, annotation, scaffolding
      - analysis.config:  Pangenomics, phylogenetics

    To run a specific pipeline with its config:
      nextflow run assembly.nf -c assembly.config --input samples.csv
      nextflow run analysis.nf -c analysis.config
========================================================================================
*/

// =========================================================================
// Orchestrator Parameters
// =========================================================================

params {
    // Pipeline selection: 'assembly', 'analysis', or 'all'
    pipeline = null

    // Input samplesheet (required for assembly pipeline)
    input = null

    // Show help
    help = false
}

// =========================================================================
// Shared Settings
// =========================================================================

// These settings are inherited by sub-pipelines when run through the orchestrator

manifest {
    name = 'bgc-link'
    author = 'BGC-link Project'
    description = 'BGC-link: Bacterial genome assembly, annotation, pangenomics, and phylogenetics'
    mainScript = 'main.nf'
    version = '2.0.0'
    nextflowVersion = '>=21.04.0'
}

// =========================================================================
// Sub-pipeline Configurations
// =========================================================================
//
// Each sub-pipeline should be run with its own config:
//
// Assembly Pipeline (assembly.nf):
//   - Config: assembly.config
//   - Input: Samplesheet with reads
//   - Output: Annotated scaffolds, summary TSV
//
// Analysis Pipeline (analysis.nf):
//   - Config: analysis.config
//   - Input: Bakta annotations from assembly pipeline
//   - Output: Pangenome, phylogenetic tree, BGC predictions
//
// =========================================================================
