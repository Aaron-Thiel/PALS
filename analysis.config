/*
========================================================================================
    BGC-link Analysis Pipeline Configuration
========================================================================================
    Downstream analysis pipeline for pangenomics and phylogenetics.
    Takes pre-existing Bakta annotation results as input.

    Run with: nextflow run analysis.nf -c analysis.config
========================================================================================
*/

params {
    // =========================================================================
    // INPUT PATHS
    // =========================================================================

    // Internal samples - directory containing assembly pipeline results
    // The pipeline will search for */pasa_filter/selected_scaffold.fasta within this directory
    // Also reads pipeline_summary.tsv from this directory for genus information
    internal = 'results/assembly_validation'

    // External annotations - directory containing pre-annotated GFF3/FNA files (optional)
    // These skip Bakta and go directly to pangenome analysis
    external = null

    // =========================================================================
    // OUTPUT DIRECTORY
    // =========================================================================

    outdir = './results/analysis'

    // Output structure will be:
    // results/analysis/
    // ├── bakta/                    # Bakta annotations
    // ├── codon_qc/                 # Codon bias QC results
    // │   ├── *_codon_qc_summary.tsv
    // │   ├── *_codon_qc_report.json
    // │   └── codon_qc_batch_summary.tsv
    // ├── panta/                    # Pangenome results
    // │   ├── gene_presence_absence.Rtab
    // │   ├── gene_annotation.csv
    // │   └── samples/
    // ├── antismash/                # BGC detection (per sample)
    // │   └── {sample_id}/
    // ├── eggnog/                   # Functional annotations
    // │   └── *.emapper.annotations
    // ├── plots/                    # Pangenome visualizations
    // │   ├── *.png
    // │   └── *.pdf
    // └── phylogenetics/            # Phylogenetic tree
    //     ├── core_genes/
    //     ├── alignments/
    //     ├── phylogeny.treefile
    //     └── tree_*.{png,svg,pdf}

    // =========================================================================
    // MODULE TOGGLES
    // =========================================================================

    codon_qc_enable     = true      // Run codon bias QC (detects assembly anomalies)
    antismash_enable    = true      // Run antiSMASH BGC detection
    eggnog_enable       = true      // Run EggNOG (uses DIAMOND, not HMMER)
    phylogenetics_enable = true     // Run phylogenetic tree construction

    // =========================================================================
    // RESOURCE LIMITS
    // =========================================================================

    max_cpus   = 8
    max_memory = 30.GB

    // =========================================================================
    // DATABASES
    // =========================================================================

    database_base   = '/BGC-data/databases'
    eggnog_db       = "${params.database_base}/eggnog"
    antismash_db    = "${params.database_base}/antismash"

    // Reference genomes directory - contains family/genus/species subdirectories
    // Each genus folder has genome_metadata.csv with quality info
    // References are stored alongside genomes:
    //   {genus}/{species}/codon_reference.json  (species-level)
    //   {genus}/codon_reference.json            (genus-level)
    reference_genomes_dir = '/BGC-data/databases/genomes/Lactobacillaceae'

    // =========================================================================
    // CODON QC (Assembly Quality Check)
    // =========================================================================
    // Detects assembly anomalies by analyzing codon usage patterns
    // Compares samples against species-level reference (preferred) or genus-level (fallback)

    // Quality thresholds for reference genomes used to build codon references
    codon_ref_min_completeness = 90.0    // Minimum completeness (%)
    codon_ref_max_contamination = 5.0    // Maximum contamination (%)

    // Reference selection
    codon_min_species_refs = 10          // Use genus-level if species has fewer refs

    // Outlier detection
    codon_zscore_threshold = 2.5         // Z-score threshold for outlier genes
    codon_min_contig_genes = 5           // Min genes per contig for suspicious assessment

    // QC status thresholds (tune based on your data)
    codon_fail_outlier_pct = 15.0        // FAIL if outlier genes exceed this %
    codon_warn_contig_outlier_frac = 0.3 // Suspicious contig if >30% outlier genes

    // =========================================================================
    // PANTA (Pangenome Analysis)
    // =========================================================================
    // Stricter settings for cohort analysis on PASA scaffolds (more contiguous)
    // vs assembly pipeline which uses permissive settings for fragmented contigs

    panta_identity       = 0.8       // Sequence identity threshold (80% similarity)
    panta_length_diff    = 0.8       // Length difference cutoff
    panta_align_long     = 0.8       // Alignment coverage for longer seq (aL)
    panta_align_short    = 0.8       // Alignment coverage for shorter seq (aS)
    panta_evalue         = '1e-06'
    panta_blast_method   = 'diamond' // 'diamond' or 'blast'
    panta_split_paralogs = true
    panta_core           = 0.99      // Core genes threshold (99%)
    panta_soft           = 0.95      // Soft core threshold (95%)
    panta_shell          = 0.15      // Shell genes threshold (15%)

    // =========================================================================
    // EGGNOG (Functional Annotation)
    // =========================================================================

    eggnog_mode  = 'diamond'         // Uses DIAMOND (not HMMER)
    eggnog_taxon = 'Lactobacillaceae'

    // =========================================================================
    // ANTISMASH (BGC Detection)
    // =========================================================================

    antismash_extra_args = ''

    // =========================================================================
    // PHYLOGENETICS
    // =========================================================================

    // Core gene extraction
    phylo_core_threshold = 0.95      // Genes present in 95% of genomes

    // MAFFT alignment
    mafft_method = 'auto'            // 'auto', 'linsi', 'einsi', 'ginsi', 'fftns2'

    // IQ-TREE
    phylo_model               = 'GTR+G'
    phylo_modelfinder         = false
    phylo_use_partition       = false
    phylo_bootstrap           = true
    phylo_bootstrap_replicates = 1000
    phylo_alrt                = 0

    // Tree Visualization
    tree_width          = 3000       // Canvas width in pixels (auto-scales for rectangular)
    tree_height         = 3000       // Canvas height in pixels (auto-scales for rectangular)
    tree_show_bootstrap = true       // Show bootstrap values
    tree_show_distances = true       // Show branch length distances
}

// Process resource configuration
process {
    errorStrategy = { task.exitStatus in [1, 104, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 3
    cpus = 2
    memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
    time = 1.h

    withName: 'BAKTA' {
        cpus = 4
        memory = { [15.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
        publishDir = [
            path: { "${params.outdir}/bakta/${sample_id}" },
            mode: 'copy'
        ]
    }

    // -------------------------------------------------------------------------
    // Codon QC processes
    // -------------------------------------------------------------------------

    withName: 'EXTRACT_CDS' {
        cpus = 2
        memory = 8.GB
        time = 1.h
    }

    withName: 'BUILD_SPECIES_REFERENCE' {
        cpus = 1
        memory = 2.GB
        time = 30.m
    }

    withName: 'BUILD_GENUS_REFERENCE' {
        cpus = 1
        memory = 4.GB
        time = 1.h
    }

    withName: 'CODON_QC' {
        cpus = 2
        memory = 4.GB
        time = 15.m
    }

    withName: 'AGGREGATE_CODON_QC' {
        cpus = 1
        memory = 2.GB
        time = 10.m
    }

    // -------------------------------------------------------------------------
    // Pangenomics processes
    // -------------------------------------------------------------------------

    withName: 'PANTA_COHORT' {
        cpus = 8
        memory = { [30.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 8.h
    }

    withName: 'EGGNOG' {
        cpus = 8
        memory = { [31.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 48.h
    }

    withName: 'ANTISMASH' {
        cpus = 4
        memory = { [12.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }  // Skip samples with antiSMASH GFF3 parsing bugs
        maxRetries = 3
    }

    withName: 'PANGENOME_PLOTS' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
    }

    withName: 'EXTRACT_CORE_GENES' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'ALIGN_CORE_GENES' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
    }

    withName: 'CONCATENATE_ALIGNMENT' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
    }

    withName: 'IQTREE3' {
        cpus = 4
        memory = { [16.GB + 8.GB * (task.attempt - 1), params.max_memory].min() }
        time = 6.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries = 3
    }

    withName: 'TREE_VISUALIZATION' {
        cpus = 1
        memory = { [4.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
        conda = "conda-forge::toytree conda-forge::packaging"
        container = null
    }
}

// Docker configuration
docker {
    enabled = true
    runOptions = "--user ${System.getenv('USER_ID') ?: '1000'}:${System.getenv('GROUP_ID') ?: '1000'} -v /home/azureuser/BGC-link/nextflow/databases:/databases -v /BGC-data/databases:/BGC-data/databases"
    temp = 'auto'
}

// Conda (for tree visualization)
conda {
    enabled = true
}

// Reporting
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

workDir = "${launchDir}/work/analysis"

manifest {
    name = 'bgc-link-analysis'
    description = 'BGC-link Analysis Pipeline: Pangenomics + Phylogenetics from Bakta annotations'
    version = '1.0.0'
    nextflowVersion = '>=21.04.0'
}
