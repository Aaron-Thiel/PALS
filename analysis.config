/*
========================================================================================
    PALS - Analysis Pipeline Configuration
========================================================================================
    Downstream analysis pipeline for pangenomics and phylogenetics.
    Takes pre-existing Bakta annotation results as input.

    Run with: nextflow run analysis.nf -c analysis.config
========================================================================================
*/

params {
    // =========================================================================
    // INPUT PATHS
    // =========================================================================

    // Internal samples - directory containing assembly pipeline results
    // The pipeline will search for */pasa_filter/selected_scaffold.fasta within this directory
    // Also reads pipeline_summary.tsv from this directory for genus information
    internal = 'results/assembly'

    // External annotations - directory containing pre-annotated GFF3/FNA files (optional)
    // These skip Bakta and go directly to pangenome analysis
    external = null

    // External annotations directory for codon bias comparison
    // Each genome has a subdirectory: {genome_id}/{genome_id}.ffn
    external_annotations_dir = '/home/azureuser/BGC-link/master_thesis/external_data/lactoannotated/annotations'

    // Use pre-existing Bakta from assembly pipeline (skip BAKTA annotation step)
    // When true, reads bakta from internal/*/bakta/ instead of running Bakta on PASA scaffolds
    spades = false

    // =========================================================================
    // OUTPUT DIRECTORY
    // =========================================================================

    outdir = './results/analysis'

    // Output structure will be:
    // results/analysis/
    // ├── bakta/                    # Bakta annotations (per sample)
    // ├── codon_qc/                 # Codon bias QC results
    // ├── pangenomics/              # Pangenome analysis
    // │   ├── panta/                # Panta pangenome output
    // │   ├── eggnog/               # EggNOG functional annotations
    // │   ├── plots/                # Family-level pangenome plots
    // │   ├── subsets/              # Genus/species-level pangenome plots
    // │   │   ├── genus_Lactiplantibacillus/plots/
    // │   │   └── species_Lactiplantibacillus_plantarum/plots/
    // │   └── bigscape/             # BiG-SCAPE BGC similarity networks
    // │       ├── genus_Lactiplantibacillus/
    // │       └── species_Lactiplantibacillus_plantarum/
    // ├── antismash/                # BGC detection (per sample)
    // │   ├── PAL001/
    // │   └── PAL002/
    // ├── phylogenetics/            # Phylogenetic trees
    // │   ├── core_genes/           # Core gene extraction
    // │   ├── tree/                 # Family-level tree
    // │   └── subsets/              # Genus/species-level subtrees
    // │       ├── genus_Lactiplantibacillus/
    // │       └── species_Lactiplantibacillus_plantarum/
    // ├── genomeviz/                # Gene comparison (scaffold vs contig)
    //     ├── PAL001/
    //     ├── PAL002/
    //     └── overview/             # Aggregated new genes summary
    // └── genome_alignment/         # Scaffold vs complete reference genome
    //     ├── reference_selection/  # Selected complete genome per sample
    //     ├── PAL001/
    //     └── PAL002/

    // =========================================================================
    // BLOCK TOGGLES
    // =========================================================================
    // Each block can run independently using cached PANTA results.
    // Disable blocks you don't need to save compute time on re-runs.

    codon_qc_enable      = true    // Codon bias QC (detects assembly anomalies)
    codon_correlation_enable = true // Codon bias vs pangenome category correlation
    pangenomics_enable   = true    // EGGNOG + pangenome plots + genus/species subsets
    phylogenetics_enable = true    // Core gene tree + genus/species subtrees
    bgc_enable           = true    // antiSMASH + BiG-SCAPE BGC similarity networks
    new_genes_enable     = true    // GenomeViz + aggregated new genes overview
    subset_analysis_enable = true  // Genus/species-level subsets (within pangenomics/phylo)
    hq_plots_enable      = false   // HQ-only pangenome plots (filters by post-scaffolding completeness)
    scaffold_min_completeness = 90 // Min pasa_completeness (%) to include in HQ plots

    // =========================================================================
    // RESOURCE LIMITS
    // =========================================================================

    max_cpus   = 8
    max_memory = 30.GB

    // =========================================================================
    // DATABASES
    // =========================================================================

    database_base   = '/BGC-data/databases'
    eggnog_db       = "${params.database_base}/eggnog"
    antismash_db    = "${params.database_base}/antismash"

    // Reference genomes directory - contains family/genus/species subdirectories
    // Each genus folder has genome_metadata.csv with quality info
    // References are stored alongside genomes:
    //   {genus}/{species}/codon_reference.json  (species-level)
    //   {genus}/codon_reference.json            (genus-level)
    reference_genomes_dir = '/BGC-data/databases/genomes/Lactobacillaceae'

    // =========================================================================
    // CODON QC (Assembly Quality Check)
    // =========================================================================
    // Detects assembly anomalies by analyzing codon usage patterns
    // Compares samples against species-level reference (preferred) or genus-level (fallback)

    // Quality thresholds for reference genomes used to build codon references
    codon_ref_min_completeness = 90.0    // Minimum completeness (%)
    codon_ref_max_contamination = 5.0    // Maximum contamination (%)

    // Reference selection
    codon_min_species_refs = 10          // Use genus-level if species has fewer refs

    // Outlier detection
    codon_zscore_threshold = 2.5         // Z-score threshold for outlier genes
    codon_min_contig_genes = 5           // Min genes per contig for suspicious assessment

    // QC status thresholds (tune based on your data)
    codon_fail_outlier_pct = 15.0        // FAIL if outlier genes exceed this %
    codon_warn_contig_outlier_frac = 0.3 // Suspicious contig if >30% outlier genes

    // Correlation analysis thresholds (gene classification in Rtab)
    codon_rare_threshold = 0.15          // Gene frequency < 15% = rare
    codon_core_threshold = 0.95          // Gene frequency >= 95% = core

    // =========================================================================
    // PANTA (Pangenome Analysis)
    // =========================================================================
    // Stricter settings for cohort analysis on PASA scaffolds (more contiguous)
    // vs assembly pipeline which uses permissive settings for fragmented contigs

    panta_identity       = 0.8       // Sequence identity threshold (80% similarity)
    panta_length_diff    = 0.8       // Length difference cutoff
    panta_align_long     = 0.8       // Alignment coverage for longer seq (aL)
    panta_align_short    = 0.8       // Alignment coverage for shorter seq (aS)
    panta_evalue         = '1e-06'
    panta_blast_method   = 'diamond' // 'diamond' or 'blast'
    panta_split_paralogs = true
    panta_core           = 0.99      // Core genes threshold (99%)
    panta_soft           = 0.95      // Soft core threshold (95%)
    panta_shell          = 0.15      // Shell genes threshold (15%)

    // =========================================================================
    // EGGNOG (Functional Annotation)
    // =========================================================================

    eggnog_mode  = 'diamond'         // Uses DIAMOND (not HMMER)
    eggnog_taxon = 'Lactobacillaceae'

    // =========================================================================
    // ANTISMASH (BGC Detection)
    // =========================================================================

    antismash_extra_args = ''

    // =========================================================================
    // PHYLOGENETICS
    // =========================================================================

    // Core gene extraction
    phylo_core_threshold = 0.95      // Genes present in 95% of genomes

    // MAFFT alignment
    mafft_method = 'auto'            // 'auto', 'linsi', 'einsi', 'ginsi', 'fftns2'

    // IQ-TREE
    phylo_model               = 'GTR+G'
    phylo_modelfinder         = false
    phylo_use_partition       = false
    phylo_bootstrap           = true
    phylo_bootstrap_replicates = 1000
    phylo_alrt                = 0

    // Tree Visualization
    tree_width          = 3000       // Canvas width in pixels (auto-scales for rectangular)
    tree_height         = 3000       // Canvas height in pixels (auto-scales for rectangular)
    tree_show_bootstrap = true       // Show bootstrap values
    tree_show_distances = true       // Show branch length distances

    // =========================================================================
    // SUBSET ANALYSIS (Genus/Species-Level)
    // =========================================================================
    // Subsets pangenome Rtab by genus/species, and prunes the main phylogenetic
    // tree to genus/species subtrees (no per-group IQ-TREE needed).
    // Only creates subsets for genera/species with at least one internal sample.

    subset_min_samples_pangenomics = 3    // Min samples for pangenome subset plots
    subtree_min_tips               = 3    // Min tips for subtree visualization
    taxonomy_csv = '/home/azureuser/BGC-link/master_thesis/external_data/taxonomy.csv'

    // =========================================================================
    // LOST GENES (Contig vs Scaffold Comparison)
    // =========================================================================

    lost_genes_min_scaffolding = 0.9  // Min scaffolding fraction to consider a gene "lost"

    // =========================================================================
    // GENOMEVIZ (New Gene Analysis + Genome Alignment)
    // =========================================================================
    // Two-step approach:
    //   1. GENE_COMPARISON (mode=comparison): scaffold vs contig new gene detection
    //   2. GENOME_ALIGNMENT_VIZ (mode=scaffold): scaffold vs nearest complete genome
    //      Only runs when a complete genome exists (selected by SELECT_COMPLETE_REFERENCE)
    // Uses aaronthiel/genomeviz:latest Docker image with stageAs for auto-detection

    // =========================================================================
    // BIGSCAPE (BGC Similarity Networks)
    // =========================================================================
    // Runs BiG-SCAPE 2 on antiSMASH BGCs grouped by genus/species subset.
    // Produces similarity networks, GCF assignments, and custom network plots.

    bigscape_cutoffs     = '0.3'     // GCF distance cutoff(s), space-separated for multiple
    bigscape_min_samples = 2         // Min internal samples with BGCs per group
    pfam_db = '/BGC-data/databases/antismash/pfam/35.0/Pfam-A.hmm'
}

// Process resource configuration
process {
    errorStrategy = { task.exitStatus in [1, 104, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 3
    cpus = 2
    memory = { [2.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
    time = 1.h

    withName: 'BAKTA' {
        cpus = 4
        memory = { [20.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 60.m
        publishDir = [
            path: { "${params.outdir}/bakta/${sample_id}" },
            mode: 'copy'
        ]
    }

    // -------------------------------------------------------------------------
    // Codon QC processes
    // -------------------------------------------------------------------------

    withName: 'EXTRACT_CDS' {
        cpus = 2
        memory = 8.GB
        time = 1.h
    }

    withName: 'BUILD_SPECIES_REFERENCE' {
        cpus = 1
        memory = 2.GB
        time = 30.m
    }

    withName: 'BUILD_GENUS_REFERENCE' {
        cpus = 1
        memory = 4.GB
        time = 1.h
    }

    withName: 'CODON_QC' {
        cpus = 2
        memory = 4.GB
        time = 15.m
    }

    withName: 'AGGREGATE_CODON_QC' {
        cpus = 1
        memory = 2.GB
        time = 10.m
    }

    withName: 'EXTERNAL_CODON_METRICS' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
    }

    withName: 'CODON_CORRELATION' {
        cpus = 2
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
        publishDir = [
            path: { "${params.outdir}/codon/correlation" },
            mode: 'copy'
        ]
    }

    withName: 'SUBSET_CODON_CORRELATION' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
        publishDir = [
            path: { "${params.outdir}/codon/subsets/${group_id}" },
            mode: 'copy'
        ]
    }

    // -------------------------------------------------------------------------
    // Pangenomics processes
    // -------------------------------------------------------------------------

    withName: 'PANTA_COHORT' {
        cpus = 8
        memory = { [30.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 8.h
    }

    withName: 'EGGNOG' {
        cpus = 8
        memory = { [31.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 48.h
    }

    withName: 'ANTISMASH' {
        cpus = 4
        memory = { [12.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }  // Skip samples with antiSMASH GFF3 parsing bugs
        maxRetries = 3
    }

    withName: 'PANGENOME_PLOTS' {
        cpus = 4
        memory = { [30.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
    }

    withName: 'EXTRACT_CORE_GENES' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'ALIGN_CORE_GENES' {
        cpus = 4
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
    }

    withName: 'CONCATENATE_ALIGNMENT' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 2.h
    }

    withName: 'IQTREE3' {
        cpus = 4
        memory = { [16.GB + 8.GB * (task.attempt - 1), params.max_memory].min() }
        time = 6.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries = 3
    }

    withName: 'TREE_VISUALIZATION' {
        cpus = 1
        memory = { [4.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    // -------------------------------------------------------------------------
    // Subset analysis processes (genus/species-level)
    // -------------------------------------------------------------------------

    withName: 'SUBSET_RTAB' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'SUBSET_PANGENOME_PLOTS' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
        publishDir = [
            path: { "${params.outdir}/pangenomics/subsets/${cohort_id}" },
            mode: 'copy'
        ]
    }

    // -------------------------------------------------------------------------
    // HQ-only pangenome plot processes
    // -------------------------------------------------------------------------

    withName: 'FILTER_RTAB_HQ' {
        cpus = 1
        memory = 4.GB
        time = 15.m
    }

    withName: 'HQ_PANGENOME_PLOTS' {
        cpus = 4
        memory = { [30.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
        publishDir = [
            path: { "${params.outdir}/pangenomics/plots_hq" },
            mode: 'copy'
        ]
    }

    withName: 'HQ_SUBSET_RTAB' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
        publishDir = [
            path: { "${params.outdir}/pangenomics/subsets_hq" },
            mode: 'copy',
            pattern: 'manifest.tsv'
        ]
    }

    withName: 'HQ_SUBSET_PANGENOME_PLOTS' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
        publishDir = [
            path: { "${params.outdir}/pangenomics/subsets_hq/${cohort_id}" },
            mode: 'copy'
        ]
    }

    withName: 'BUILD_SUBTREE_GROUPS' {
        cpus = 1
        memory = 2.GB
        time = 10.m
    }

    withName: 'SUBTREE_VISUALIZATION' {
        cpus = 1
        memory = { [4.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    // -------------------------------------------------------------------------
    // GenomeViz processes
    // -------------------------------------------------------------------------

    withName: 'GENE_COMPARISON' {
        cpus = 1
        memory = { [2.GB + 2.GB * (task.attempt - 1), params.max_memory].min() }
        time = 10.m
        errorStrategy = { task.exitStatus == 137 && task.attempt <= maxRetries ? 'retry' : 'ignore' }
        maxRetries = 1
        // No publishDir — output feeds NEW_GENES_OVERVIEW internally via channels.
        // Visualizations against complete genomes are in genome_alignment/ instead.
    }

    withName: 'GENOME_ALIGNMENT_VIZ' {
        cpus = 1
        memory = { [2.GB + 2.GB * (task.attempt - 1), params.max_memory].min() }
        time = 10.m
        errorStrategy = { task.exitStatus == 137 && task.attempt <= maxRetries ? 'retry' : 'ignore' }
        maxRetries = 1
        publishDir = [
            path: { "${params.outdir}/genome_alignment" },
            mode: 'copy'
        ]
    }

    withName: 'SELECT_COMPLETE_REFERENCE' {
        cpus = 1
        memory = 2.GB
        time = 10.m
        publishDir = [
            path: { "${params.outdir}/genome_alignment/reference_selection" },
            mode: 'copy'
        ]
    }

    withName: 'NEW_GENES_OVERVIEW' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 30.m
    }

    withName: 'LOST_GENES' {
        cpus = 2
        memory = { [8.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 1.h
    }

    // -------------------------------------------------------------------------
    // BiG-SCAPE processes (BGC similarity networks)
    // -------------------------------------------------------------------------

    withName: 'COLLECT_SUBSET_BGCS' {
        cpus = 1
        memory = 2.GB
        time = 15.m
    }

    withName: 'BIGSCAPE' {
        cpus = 4
        memory = { [16.GB + 4.GB * (task.attempt - 1), params.max_memory].min() }
        time = 4.h
    }

    withName: 'BIGSCAPE_NETWORK_PLOT' {
        cpus = 1
        memory = 4.GB
        time = 30.m
    }
}

// Docker configuration
docker {
    enabled = true
    runOptions = "--user ${System.getenv('USER_ID') ?: '1000'}:${System.getenv('GROUP_ID') ?: '1000'} -v /home/azureuser/BGC-link/nextflow/databases:/databases -v /BGC-data/databases:/BGC-data/databases"
    temp = 'auto'
}

// Conda (for tree visualization)
conda {
    enabled = true
}

// Reporting
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}

// Work directory matches outdir name for easy cleanup:
//   rm -rf results/analysis work/analysis
workDir = "${launchDir}/work/${new File(params.outdir).name}"

manifest {
    name = 'PALS - Analysis Pipeline'
    description = 'PALS - Analysis Pipeline: Pangenomics + Phylogenetics + Gene Recovery + Codon Bias + BGC Analysis'
    author = 'Aaron Thiel'
    mainScript = 'analysis.nf'
    version = '1.0.0'
    nextflowVersion = '>=21.04.0'
}
